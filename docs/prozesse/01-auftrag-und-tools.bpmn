        <dc:Bounds x="1062" y="424" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1043" y="480" width="89" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_P01_Rueckfrage" bpmnElement="P01_Rueckfrage" bioc:stroke="#0d4372" bioc:fill="#bbdefb" color:background-color="#bbdefb" color:border-color="#0d4372">
        <dc:Bounds x="1172" y="250" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_P01_Index" bpmnElement="P01_Index" bioc:stroke="#5b176d" bioc:fill="#e1bee7" color:background-color="#e1bee7" color:border-color="#5b176d">
        <dc:Bounds x="1172" y="409" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_P01_ToolNoetig" bpmnElement="P01_ToolNoetig" isMarkerVisible="true">
        <dc:Bounds x="1332" y="424" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1388" y="435" width="89" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_P01_Konto" bpmnElement="P01_Konto" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
        <dc:Bounds x="1442" y="760" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_P01_Zugriff" bpmnElement="P01_Zugriff" isMarkerVisible="true">
        <dc:Bounds x="1602" y="775" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1593" y="741" width="68" height="28" />
