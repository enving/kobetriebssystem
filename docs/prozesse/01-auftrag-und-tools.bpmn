        <dc:Bounds x="110" y="360" width="2285" height="370" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_P01_Lane_g" bpmnElement="P01_Lane_g" isHorizontal="true">
        <dc:Bounds x="110" y="730" width="2285" height="270" />
      </bpmndi:BPMNShape>
