        <dc:Bounds x="266" y="760" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_P01_Paket" bpmnElement="P01_Paket" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
        <dc:Bounds x="426" y="760" width="100" height="80" />
      </bpmndi:BPMNShape>
