<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_p01AuftragKontextUndPersoenlicheTools" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collaboration_p01AuftragKontextUndPersoenlicheTools">
    <bpmn:participant id="P01_Pool" name="P01 · Auftrag, Kontext und persönliche Tools" processRef="Process_P01" />
    <bpmn:participant id="P01_Tools" name="Persönliche Quellsysteme · z. B. Gmail / Composio" />
    <bpmn:messageFlow id="P01_Message_Aufruf" name="Aufruf als angemeldete Person" sourceRef="P01_Lesen" targetRef="P01_Tools" />
    <bpmn:messageFlow id="P01_Message_Belege" name="zulässige Daten + Herkunft" sourceRef="P01_Tools" targetRef="P01_Belege" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P01" name="P01 · Auftrag, Kontext und persönliche Tools" isExecutable="false">
    <bpmn:documentation>Entwurf v0.1 | GPT-6.1-sol | 11.11.2026
Zweck: Den Auftrag einer eindeutig angemeldeten Person mit passenden Quellen und einem festen Quellstand vorbereiten.
Offen: PRD L3/L4: persönlicher Kontext; L6/L7/L24: Rechte und fehlende Quellen. OAuth- und Nutzerzuordnung sind in der Testinstanz noch nachzuweisen.
Quellen: ../../AGENTS.md ; ../szenarien.md ; https://docs.openwebui.com/features/extensibility/mcp/#connecting-an-account ; https://ai-first.ai/insights/wie-unser-kontext-layer-mitwaechst ; ../../beispiel/openwebui/fixtures/04-test-cases.md
Lesart: Fachlicher Sollprozess zur Diskussion, keine Betriebsfreigabe. Nicht ausführbar. Bahnen zeigen Verantwortung, keine nachgewiesene technische Isolation.</bpmn:documentation>
    <bpmn:laneSet id="laneSet_p01AuftragKontextUndPersoenlicheTools">
      <bpmn:lane id="P01_Lane_m" name="Mitarbeitende">
        <bpmn:flowNodeRef>P01_Rueckfrage</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P01_Lane_a" name="OpenWebUI-Agent">
        <bpmn:flowNodeRef>P01_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_Stop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_Aufgabe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_Klar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_Index</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_ToolNoetig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_Fehlt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_Lesen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_Toolfehler</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_Zusammen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_PaketAuftrag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_Ende</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_Join_Aufgabe</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P01_Lane_g" name="Adapter / Anmeldung / Rechteprüfung">
        <bpmn:flowNodeRef>P01_Identitaet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_Paket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_Gueltig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_Konto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_Zugriff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_Blockiert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P01_Belege</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P01_Start" name="Bitte eingegangen">
      <bpmn:documentation>Die Nutzernachricht ist der Auftrag. Eingebettete Anweisungen aus Dokumenten werden als Daten behandelt.
Quelle: ../../AGENTS.md</bpmn:documentation>
      <bpmn:outgoing>P01_Flow_Start_Identitaet</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="P01_Flow_Start_Identitaet" sourceRef="P01_Start" targetRef="P01_Identitaet" />
    <bpmn:serviceTask id="P01_Identitaet" name="Nutzer und erlaubte Kreise ermitteln">
      <bpmn:documentation>Die authentifizierte Sitzung bestimmt die Person. Eine vom Modell genannte Nutzerkennung genügt nicht als Berechtigungsnachweis.
Quelle: ../../SICHERHEIT.md</bpmn:documentation>
      <bpmn:incoming>P01_Flow_Start_Identitaet</bpmn:incoming>
      <bpmn:outgoing>P01_Flow_Identitaet_Paket</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="P01_Flow_Identitaet_Paket" sourceRef="P01_Identitaet" targetRef="P01_Paket" />
    <bpmn:serviceTask id="P01_Paket" name="Freigegebenen Paketstand binden">
      <bpmn:documentation>Regeln, Index, Landkarte, passende Skills und persönliche Anweisungen laden. Version und Quell-Commit an den Auftrag binden; fehlende Pflichtquellen sichtbar machen.
Quelle: ../../installation/README.md</bpmn:documentation>
      <bpmn:incoming>P01_Flow_Identitaet_Paket</bpmn:incoming>
      <bpmn:outgoing>P01_Flow_Paket_Gueltig</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="P01_Flow_Paket_Gueltig" sourceRef="P01_Paket" targetRef="P01_Gueltig" />
    <bpmn:exclusiveGateway id="P01_Gueltig" name="Startgrundlage gültig?">
      <bpmn:documentation>Start ohne zuordenbare Identität oder erforderliche Quellen ist kein gültiger Firmenauftrag.
Quelle: ../../beispiel/openwebui/fixtures/04-test-cases.md</bpmn:documentation>
      <bpmn:incoming>P01_Flow_Paket_Gueltig</bpmn:incoming>
      <bpmn:outgoing>P01_Flow_Gueltig_Stop</bpmn:outgoing>
      <bpmn:outgoing>P01_Flow_Gueltig_Aufgabe</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P01_Flow_Gueltig_Stop" name="nein" sourceRef="P01_Gueltig" targetRef="P01_Stop" />
    <bpmn:sequenceFlow id="P01_Flow_Gueltig_Aufgabe" name="ja" sourceRef="P01_Gueltig" targetRef="P01_Join_Aufgabe" />
    <bpmn:endEvent id="P01_Stop" name="Start blockiert">
      <bpmn:documentation>Fehlende Anmeldung, Quelle oder Version benennen. Kein Zugriff über ein anderes Konto.
Quelle: ../../AGENTS.md</bpmn:documentation>
      <bpmn:incoming>P01_Flow_Gueltig_Stop</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P01_Aufgabe" name="Ziel und Fertigkriterien klären">
      <bpmn:documentation>Passenden Skill nach Beschreibung wählen. Erwartetes Ergebnis, erlaubten Zielkreis und nötige Quellen erkennen.
Quelle: ../szenarien.md</bpmn:documentation>
      <bpmn:incoming>P01_Flow_Join_Aufgabe_Aufgabe</bpmn:incoming>
      <bpmn:outgoing>P01_Flow_Aufgabe_Klar</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="P01_Flow_Aufgabe_Klar" sourceRef="P01_Aufgabe" targetRef="P01_Klar" />
    <bpmn:exclusiveGateway id="P01_Klar" name="Auftrag hinreichend klar?">
      <bpmn:documentation>Fachliche Lücken und unklare Freigaben werden nicht durch Annahmen ersetzt.
Quelle: ../../AGENTS.md</bpmn:documentation>
      <bpmn:incoming>P01_Flow_Aufgabe_Klar</bpmn:incoming>
      <bpmn:outgoing>P01_Flow_Klar_Rueckfrage</bpmn:outgoing>
      <bpmn:outgoing>P01_Flow_Klar_Index</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P01_Flow_Klar_Rueckfrage" name="nein" sourceRef="P01_Klar" targetRef="P01_Rueckfrage" />
    <bpmn:sequenceFlow id="P01_Flow_Klar_Index" name="ja" sourceRef="P01_Klar" targetRef="P01_Index" />
    <bpmn:userTask id="P01_Rueckfrage" name="Gezielte Rückfrage beantworten">
      <bpmn:documentation>Die Person klärt die eine entscheidende offene Angabe oder bricht ab. Der neue Auftrag bleibt an ihre Sitzung gebunden.
Quelle: ../../AGENTS.md</bpmn:documentation>
      <bpmn:incoming>P01_Flow_Klar_Rueckfrage</bpmn:incoming>
      <bpmn:outgoing>P01_Flow_Rueckfrage_Aufgabe</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="P01_Flow_Rueckfrage_Aufgabe" sourceRef="P01_Rueckfrage" targetRef="P01_Join_Aufgabe" />
    <bpmn:serviceTask id="P01_Index" name="Index und Quellenverweise lesen">
      <bpmn:documentation>Gemeinsame gültige Grundlagen zuerst, persönliche oder fachliche Ergänzungen nur bei Bedarf. Keine vollständigen privaten Chats in gemeinsamen Kontext kopieren.
Quelle: https://ai-first.ai/insights/wie-unser-kontext-layer-mitwaechst</bpmn:documentation>
      <bpmn:incoming>P01_Flow_Klar_Index</bpmn:incoming>
      <bpmn:outgoing>P01_Flow_Index_ToolNoetig</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="P01_Flow_Index_ToolNoetig" sourceRef="P01_Index" targetRef="P01_ToolNoetig" />
    <bpmn:exclusiveGateway id="P01_ToolNoetig" name="Live-Quelle nötig?">
      <bpmn:documentation>Mails und laufende Vorgänge bleiben im Quellsystem. Statisches Firmenwissen bleibt in der zuständigen Quelle.
Quelle: https://ai-first.ai/insights/wie-unser-kontext-layer-mitwaechst</bpmn:documentation>
      <bpmn:incoming>P01_Flow_Index_ToolNoetig</bpmn:incoming>
      <bpmn:outgoing>P01_Flow_ToolNoetig_Konto</bpmn:outgoing>
      <bpmn:outgoing>P01_Flow_ToolNoetig_Zusammen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P01_Flow_ToolNoetig_Konto" name="ja" sourceRef="P01_ToolNoetig" targetRef="P01_Konto" />
    <bpmn:sequenceFlow id="P01_Flow_ToolNoetig_Zusammen" name="nein" sourceRef="P01_ToolNoetig" targetRef="P01_Zusammen" />
    <bpmn:serviceTask id="P01_Konto" name="Eigenes Tool-Konto und Umfang prüfen">
      <bpmn:documentation>Bei OAuth wird die Verbindung der angemeldeten Person verwendet. Eine globale Verbindung zum Postfach einer anderen Person ist kein Ersatz.
Quelle: https://docs.openwebui.com/features/extensibility/mcp/#connecting-an-account</bpmn:documentation>
      <bpmn:incoming>P01_Flow_ToolNoetig_Konto</bpmn:incoming>
      <bpmn:outgoing>P01_Flow_Konto_Zugriff</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="P01_Flow_Konto_Zugriff" sourceRef="P01_Konto" targetRef="P01_Zugriff" />
    <bpmn:exclusiveGateway id="P01_Zugriff" name="Zugriff erlaubt?">
      <bpmn:documentation>Der Connector und das Quellsystem müssen die Rechte durchsetzen. Tool-Auswahl im Prompt allein beweist keine Isolation.
Quelle: ../../SICHERHEIT.md</bpmn:documentation>
      <bpmn:incoming>P01_Flow_Konto_Zugriff</bpmn:incoming>
      <bpmn:outgoing>P01_Flow_Zugriff_Fehlt</bpmn:outgoing>
      <bpmn:outgoing>P01_Flow_Zugriff_Lesen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P01_Flow_Zugriff_Fehlt" name="nein" sourceRef="P01_Zugriff" targetRef="P01_Fehlt" />
    <bpmn:sequenceFlow id="P01_Flow_Zugriff_Lesen" name="ja" sourceRef="P01_Zugriff" targetRef="P01_Lesen" />
    <bpmn:endEvent id="P01_Fehlt" name="Zugriff fehlt: offen melden">
      <bpmn:documentation>Benennen, welche Quelle nicht gelesen werden konnte, ohne deren gesperrten Inhalt offenzulegen.
Quelle: ../../AGENTS.md</bpmn:documentation>
      <bpmn:incoming>P01_Flow_Zugriff_Fehlt</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P01_Lesen" name="Quelle direkt über Tool lesen">
      <bpmn:documentation>Gmail oder ein anderer Dienst wird über OpenWebUI aufgerufen. Nur benötigte Daten lesen; keine Tool-Zugangsdaten an Codex weiterreichen.
Quelle: ../szenarien.md</bpmn:documentation>
      <bpmn:incoming>P01_Flow_Zugriff_Lesen</bpmn:incoming>
      <bpmn:outgoing>P01_Flow_Lesen_Belege</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="P01_Flow_Lesen_Belege" sourceRef="P01_Lesen" targetRef="P01_Belege" />
    <bpmn:boundaryEvent id="P01_Toolfehler" name="Tool-Aufruf gescheitert" attachedToRef="P01_Lesen">
      <bpmn:documentation>Toolfehler als technischen Blocker zurückgeben, nicht als fehlende Information erfinden. Quelle: ../../beispiel/openwebui/fixtures/04-test-cases.md</bpmn:documentation>
      <bpmn:outgoing>P01_Flow_Toolfehler_Blockiert</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="error_toolAufrufGescheitert" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="P01_Flow_Toolfehler_Blockiert" sourceRef="P01_Toolfehler" targetRef="P01_Blockiert" />
    <bpmn:endEvent id="P01_Blockiert" name="Toolfehler: blockiert">
      <bpmn:documentation>Technischen Blocker an P00 zurückgeben. Keine andere persönliche Verbindung als Umweg verwenden.
Quelle: ../../SICHERHEIT.md</bpmn:documentation>
      <bpmn:incoming>P01_Flow_Toolfehler_Blockiert</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P01_Belege" name="Belege und Sichtbarkeit festhalten">
      <bpmn:documentation>Quelle, abgerufener Stand und zulässiger Empfängerkreis begleiten das Ergebnis. Ein abgeleitetes Ergebnis wird nicht automatisch firmenöffentlich.
Quelle: https://ai-first.ai/insights/wie-unser-kontext-layer-mitwaechst</bpmn:documentation>
      <bpmn:incoming>P01_Flow_Lesen_Belege</bpmn:incoming>
      <bpmn:outgoing>P01_Flow_Belege_Zusammen</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="P01_Flow_Belege_Zusammen" sourceRef="P01_Belege" targetRef="P01_Zusammen" />
    <bpmn:exclusiveGateway id="P01_Zusammen">
      <bpmn:documentation>Quellen aus Wiki und optionalem Live-Aufruf werden für genau diesen Auftrag zusammengestellt.
Quelle: ../szenarien.md</bpmn:documentation>
      <bpmn:incoming>P01_Flow_ToolNoetig_Zusammen</bpmn:incoming>
      <bpmn:incoming>P01_Flow_Belege_Zusammen</bpmn:incoming>
      <bpmn:outgoing>P01_Flow_Zusammen_PaketAuftrag</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P01_Flow_Zusammen_PaketAuftrag" sourceRef="P01_Zusammen" targetRef="P01_PaketAuftrag" />
    <bpmn:serviceTask id="P01_PaketAuftrag" name="Ergebnis oder Arbeitsauftrag vorbereiten">
      <bpmn:documentation>Einfache Fragen selbst mit Quellen beantworten. Für Terminalarbeit nur nötige freigegebene Eingaben, Fertigkriterien, Dateibereich und Ergebnisziel übergeben.
Quelle: ../szenarien.md</bpmn:documentation>
      <bpmn:incoming>P01_Flow_Zusammen_PaketAuftrag</bpmn:incoming>
      <bpmn:outgoing>P01_Flow_PaketAuftrag_Ende</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="P01_Flow_PaketAuftrag_Ende" sourceRef="P01_PaketAuftrag" targetRef="P01_Ende" />
    <bpmn:endEvent id="P01_Ende" name="Auftrag und zulässige Quellen bereit">
      <bpmn:documentation>Rückgabe an P00 mit Version und Herkunft; noch keine Aussage über Ergebnisqualität oder Freigabe.
Quelle: ../szenarien.md</bpmn:documentation>
      <bpmn:incoming>P01_Flow_PaketAuftrag_Ende</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P01_Join_Aufgabe">
      <bpmn:documentation>Alternative Eingänge ausdrücklich zusammenführen; keine Synchronisation paralleler Ausführungen.
Quelle: ../szenarien.md</bpmn:documentation>
      <bpmn:incoming>P01_Flow_Gueltig_Aufgabe</bpmn:incoming>
      <bpmn:incoming>P01_Flow_Rueckfrage_Aufgabe</bpmn:incoming>
      <bpmn:outgoing>P01_Flow_Join_Aufgabe_Aufgabe</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P01_Flow_Join_Aufgabe_Aufgabe" sourceRef="P01_Join_Aufgabe" targetRef="P01_Aufgabe" />
  </bpmn:process>
  <bpmn:error id="error_toolAufrufGescheitert" name="Tool-Aufruf gescheitert" errorCode="TOOL_FAILED" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_collaboration_p01AuftragKontextUndPersoenliche">
    <bpmndi:BPMNPlane id="BPMNPlane_collaboration_p01AuftragKontextUndPersoenlicheTools" bpmnElement="collaboration_p01AuftragKontextUndPersoenlicheTools">
