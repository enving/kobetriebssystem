      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_P01_Aufgabe" bpmnElement="P01_Aufgabe" bioc:stroke="#5b176d" bioc:fill="#e1bee7" color:background-color="#e1bee7" color:border-color="#5b176d">
        <dc:Bounds x="902" y="409" width="100" height="80" />
