<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_p00VonDerAufgabeZurGemeinsamen" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collaboration_p00VonDerAufgabeZurGemeinsamen">
    <bpmn:participant id="P00_Pool" name="P00 · Von der Aufgabe zur gemeinsamen Verbesserung" processRef="Process_P00" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P00" name="P00 · Von der Aufgabe zur gemeinsamen Verbesserung" isExecutable="false">
    <bpmn:documentation>Entwurf v0.1 | GPT-6.1-sol | 11.11.2026
Zweck: Überblick über den Arbeitskreislauf; die aufgerufenen P01–P07 enthalten die Details.
Offen: PRD L25: Mandat von Codex; L6/L7: Rechte und Informationsfluss; L10: Prüfer; L5: laufende Sitzungen. Die Anbindung wird hier beschrieben, noch nicht eingerichtet.
Quellen: ../szenarien.md ; ../../AGENTS.md ; ../../installation/README.md ; https://ai-first.ai/insights/ai-first-ki-betriebssystem-2-0
Lesart: Fachlicher Sollprozess zur Diskussion, keine Betriebsfreigabe. Nicht ausführbar. Bahnen zeigen Verantwortung, keine nachgewiesene technische Isolation.</bpmn:documentation>
    <bpmn:laneSet id="laneSet_p00VonDerAufgabeZurGemeinsamen">
      <bpmn:lane id="P00_Lane_m" name="Mitarbeitende">
        <bpmn:flowNodeRef>P00_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_EndeOffen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_Ende</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_Join_EndeOffen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_Join_Ende</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P00_Lane_a" name="OpenWebUI / persönlicher Arbeitsagent">
        <bpmn:flowNodeRef>P00_Auftrag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_TerminalNoetig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_Vorbereitet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_Terminal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_Ergebnis</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_Ausgefuehrt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_Pruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_Status</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_Fortsetzen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P00_Join_Auftrag</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P00_Lane_g" name="Firmenbetrieb / zuständige Quelle">
        <bpmn:flowNodeRef>P00_Korrektur</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P00_Start" name="Aufgabe liegt vor">
      <bpmn:documentation>Eine Person fragt im Chat. Freigegebene Routinen sind ein zweiter Einstieg nach P06.
Quelle: ../szenarien.md</bpmn:documentation>
      <bpmn:outgoing>P00_Flow_Start_Auftrag</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="P00_Flow_Start_Auftrag" sourceRef="P00_Start" targetRef="P00_Join_Auftrag" />
    <bpmn:callActivity id="P00_Auftrag" name="P01 · Auftrag, Kontext und persönliche Tools" calledElement="Process_P01">
      <bpmn:documentation>Identität und Paketstand binden, benötigte Quellen auswählen, nur im zulässigen Konto lesen. Abbruchfälle bleiben in P01.
Quelle: ../szenarien.md</bpmn:documentation>
      <bpmn:incoming>P00_Flow_Join_Auftrag_Auftrag</bpmn:incoming>
      <bpmn:outgoing>P00_Flow_Auftrag_Vorbereitet</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="P00_Flow_Auftrag_Vorbereitet" sourceRef="P00_Auftrag" targetRef="P00_Vorbereitet" />
    <bpmn:exclusiveGateway id="P00_TerminalNoetig" name="Terminal-Arbeit nötig?">
      <bpmn:documentation>Ein direkter Tool-Aufruf oder eine belegte Antwort braucht nicht automatisch einen Terminalauftrag.
Quelle: ../szenarien.md</bpmn:documentation>
      <bpmn:incoming>P00_Flow_Vorbereitet_TerminalNoetig</bpmn:incoming>
      <bpmn:outgoing>P00_Flow_TerminalNoetig_Terminal</bpmn:outgoing>
      <bpmn:outgoing>P00_Flow_TerminalNoetig_Ergebnis</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P00_Flow_TerminalNoetig_Terminal" name="ja" sourceRef="P00_TerminalNoetig" targetRef="P00_Terminal" />
    <bpmn:sequenceFlow id="P00_Flow_TerminalNoetig_Ergebnis" name="nein" sourceRef="P00_TerminalNoetig" targetRef="P00_Ergebnis" />
    <bpmn:exclusiveGateway id="P00_Vorbereitet" name="Vorbereitung erfolgreich?">
      <bpmn:documentation>Ein blockierendes Ende von P01 darf nicht als vollständiger Arbeitsauftrag an Codex oder den Prüfer weiterlaufen.
Quelle: ../../AGENTS.md</bpmn:documentation>
      <bpmn:incoming>P00_Flow_Auftrag_Vorbereitet</bpmn:incoming>
      <bpmn:outgoing>P00_Flow_Vorbereitet_TerminalNoetig</bpmn:outgoing>
      <bpmn:outgoing>P00_Flow_Vorbereitet_EndeOffen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P00_Flow_Vorbereitet_TerminalNoetig" name="ja" sourceRef="P00_Vorbereitet" targetRef="P00_TerminalNoetig" />
    <bpmn:sequenceFlow id="P00_Flow_Vorbereitet_EndeOffen" name="nein / blockiert" sourceRef="P00_Vorbereitet" targetRef="P00_Join_EndeOffen" />
    <bpmn:callActivity id="P00_Terminal" name="P02 · Begrenzten Terminalauftrag bearbeiten" calledElement="Process_P02">
      <bpmn:documentation>Nur mit freigegebenem Mandat und belegter Isolation. Ein blockierter Aufruf liefert einen Status, keinen erfundenen Erfolg.
Quelle: ../../PRD.md</bpmn:documentation>
      <bpmn:incoming>P00_Flow_TerminalNoetig_Terminal</bpmn:incoming>
      <bpmn:outgoing>P00_Flow_Terminal_Ausgefuehrt</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="P00_Flow_Terminal_Ausgefuehrt" sourceRef="P00_Terminal" targetRef="P00_Ausgefuehrt" />
    <bpmn:exclusiveGateway id="P00_Ergebnis">
      <bpmn:documentation>Zusammenführung der Alternativen: Ergebnis ohne Terminal oder Ergebnis eines Terminalauftrags.
Quelle: ../szenarien.md</bpmn:documentation>
      <bpmn:incoming>P00_Flow_TerminalNoetig_Ergebnis</bpmn:incoming>
      <bpmn:incoming>P00_Flow_Ausgefuehrt_Ergebnis</bpmn:incoming>
      <bpmn:outgoing>P00_Flow_Ergebnis_Pruefen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P00_Flow_Ergebnis_Pruefen" sourceRef="P00_Ergebnis" targetRef="P00_Pruefen" />
    <bpmn:exclusiveGateway id="P00_Ausgefuehrt" name="Terminal-Ergebnis vorhanden?">
      <bpmn:documentation>BLOCKIERT oder ABBRUCH aus P02 beendet diesen Durchlauf. Nur ein auswertbares Ergebnis geht zur Gegenprüfung.
Quelle: ../../AGENTS.md</bpmn:documentation>
      <bpmn:incoming>P00_Flow_Terminal_Ausgefuehrt</bpmn:incoming>
      <bpmn:outgoing>P00_Flow_Ausgefuehrt_Ergebnis</bpmn:outgoing>
      <bpmn:outgoing>P00_Flow_Ausgefuehrt_EndeOffen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P00_Flow_Ausgefuehrt_Ergebnis" name="ja" sourceRef="P00_Ausgefuehrt" targetRef="P00_Ergebnis" />
    <bpmn:sequenceFlow id="P00_Flow_Ausgefuehrt_EndeOffen" name="nein / abgebrochen" sourceRef="P00_Ausgefuehrt" targetRef="P00_Join_EndeOffen" />
    <bpmn:callActivity id="P00_Pruefen" name="P03 · Ergebnis prüfen und vorlegen" calledElement="Process_P03">
      <bpmn:documentation>Gegenprüfung mit zulässigen Quellen und menschliche Entscheidung; Rückgabe enthält ANGENOMMEN, KORREKTUR, OFFEN oder ABBRUCH.
Quelle: ../../agents/pruefer.md</bpmn:documentation>
      <bpmn:incoming>P00_Flow_Ergebnis_Pruefen</bpmn:incoming>
      <bpmn:outgoing>P00_Flow_Pruefen_Status</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="P00_Flow_Pruefen_Status" sourceRef="P00_Pruefen" targetRef="P00_Status" />
    <bpmn:exclusiveGateway id="P00_Status" name="Wie endet der Auftrag?">
      <bpmn:documentation>Der Prüflauf ist keine automatische Versandfreigabe. Offene und abgebrochene Aufträge bleiben als solche sichtbar.
Quelle: ../../AGENTS.md</bpmn:documentation>
      <bpmn:incoming>P00_Flow_Pruefen_Status</bpmn:incoming>
      <bpmn:outgoing>P00_Flow_Status_EndeOffen</bpmn:outgoing>
      <bpmn:outgoing>P00_Flow_Status_Korrektur</bpmn:outgoing>
      <bpmn:outgoing>P00_Flow_Status_Ende</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P00_Flow_Status_EndeOffen" name="OFFEN / BLOCKIERT / ABBRUCH" sourceRef="P00_Status" targetRef="P00_Join_EndeOffen" />
    <bpmn:sequenceFlow id="P00_Flow_Status_Korrektur" name="Korrektur bestätigt" sourceRef="P00_Status" targetRef="P00_Korrektur" />
    <bpmn:sequenceFlow id="P00_Flow_Status_Ende" name="angenommen" sourceRef="P00_Status" targetRef="P00_Join_Ende" />
    <bpmn:endEvent id="P00_EndeOffen" name="Offen oder abgebrochen">
      <bpmn:documentation>Kein fachlich fertiges Ergebnis behaupten; konkreten Blocker und bisherigen Stand nennen.
Quelle: ../../AGENTS.md</bpmn:documentation>
      <bpmn:incoming>P00_Flow_Join_EndeOffen_EndeOffen</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="P00_Korrektur" name="P04 · Korrektur passend einordnen" calledElement="Process_P04">
      <bpmn:documentation>Nur bei einer bestätigten Korrektur. Persönliches bleibt persönlich; gemeinsame Änderungen gehen über Vorschlag, Prüfung und zulässige Freigabe.
Quelle: ../../AGENTS.md</bpmn:documentation>
      <bpmn:incoming>P00_Flow_Status_Korrektur</bpmn:incoming>
      <bpmn:outgoing>P00_Flow_Korrektur_Fortsetzen</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="P00_Flow_Korrektur_Fortsetzen" sourceRef="P00_Korrektur" targetRef="P00_Fortsetzen" />
    <bpmn:endEvent id="P00_Ende" name="Ergebnis und Stand nachvollziehbar">
      <bpmn:documentation>Die Person hat das Ergebnis angenommen oder ihre Korrektur wurde eingeordnet. Gemeinsamer Paketstand ändert sich ausschließlich im Freigabeprozess.
Quelle: ../../AGENTS.md</bpmn:documentation>
      <bpmn:incoming>P00_Flow_Join_Ende_Ende</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P00_Fortsetzen" name="Weiterbearbeitung im Mandat?">
      <bpmn:documentation>Eine Korrektur kann eine begrenzte Überarbeitung auslösen. Quellen, Rechte und verbleibende Laufgrenzen erneut prüfen. Andernfalls ist nur die Korrektur eingeordnet.
Quelle: ../../AGENTS.md</bpmn:documentation>
      <bpmn:incoming>P00_Flow_Korrektur_Fortsetzen</bpmn:incoming>
      <bpmn:outgoing>P00_Flow_Fortsetzen_Auftrag</bpmn:outgoing>
      <bpmn:outgoing>P00_Flow_Fortsetzen_Ende</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P00_Flow_Fortsetzen_Auftrag" name="ja" sourceRef="P00_Fortsetzen" targetRef="P00_Join_Auftrag" />
    <bpmn:sequenceFlow id="P00_Flow_Fortsetzen_Ende" name="nein" sourceRef="P00_Fortsetzen" targetRef="P00_Join_Ende" />
    <bpmn:exclusiveGateway id="P00_Join_Auftrag">
      <bpmn:documentation>Alternative Eingänge ausdrücklich zusammenführen; keine Synchronisation paralleler Ausführungen.
Quelle: ../szenarien.md</bpmn:documentation>
      <bpmn:incoming>P00_Flow_Start_Auftrag</bpmn:incoming>
      <bpmn:incoming>P00_Flow_Fortsetzen_Auftrag</bpmn:incoming>
      <bpmn:outgoing>P00_Flow_Join_Auftrag_Auftrag</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P00_Flow_Join_Auftrag_Auftrag" sourceRef="P00_Join_Auftrag" targetRef="P00_Auftrag" />
    <bpmn:exclusiveGateway id="P00_Join_EndeOffen">
      <bpmn:documentation>Alternative Eingänge ausdrücklich zusammenführen; keine Synchronisation paralleler Ausführungen.
Quelle: ../szenarien.md</bpmn:documentation>
      <bpmn:incoming>P00_Flow_Vorbereitet_EndeOffen</bpmn:incoming>
      <bpmn:incoming>P00_Flow_Ausgefuehrt_EndeOffen</bpmn:incoming>
      <bpmn:incoming>P00_Flow_Status_EndeOffen</bpmn:incoming>
      <bpmn:outgoing>P00_Flow_Join_EndeOffen_EndeOffen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P00_Flow_Join_EndeOffen_EndeOffen" sourceRef="P00_Join_EndeOffen" targetRef="P00_EndeOffen" />
    <bpmn:exclusiveGateway id="P00_Join_Ende">
      <bpmn:documentation>Alternative Eingänge ausdrücklich zusammenführen; keine Synchronisation paralleler Ausführungen.
Quelle: ../szenarien.md</bpmn:documentation>
      <bpmn:incoming>P00_Flow_Status_Ende</bpmn:incoming>
      <bpmn:incoming>P00_Flow_Fortsetzen_Ende</bpmn:incoming>
      <bpmn:outgoing>P00_Flow_Join_Ende_Ende</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P00_Flow_Join_Ende_Ende" sourceRef="P00_Join_Ende" targetRef="P00_Ende" />
    <bpmn:textAnnotation id="P00_Querschnitt">
      <bpmn:text>P05 Kontextpflege · P06 Routinen · P07 Testbetrieb
Eigene Detailprozesse, keine eingeschalteten Dienste.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="P00_Flow_Korrektur_Querschnitt" sourceRef="P00_Korrektur" targetRef="P00_Querschnitt" />
  </bpmn:process>
