<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_p04KorrekturAenderungsvorschlag" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collaboration_p04KorrekturAenderungsvorschlag">
    <bpmn:participant id="P04_Pool" name="P04 · Korrektur, Änderungsvorschlag und Verteilung" processRef="Process_P04" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P04" name="P04 · Korrektur, Änderungsvorschlag und Verteilung" isExecutable="false">
    <bpmn:documentation>Entwurf v0.1 | GPT-6.1-sol | 11.11.2026
Zweck: Passende Korrekturen in die zuständige Quelle zurückführen und eine geprüfte Fassung für berechtigte Sitzungen bereitstellen.
Offen: L8: Rückweg ohne Repo-Leserecht; L6: Pakete je Kreis; L5: Wechsel bestehender Sitzungen. Diagramm beschreibt Prüfpunkte und löst die technischen Lücken nicht.
Quellen: ../../AGENTS.md ; ../../installation/README.md ; ../pruefszenarien.md ; ../../PRD.md
Lesart: Fachlicher Sollprozess zur Diskussion, keine Betriebsfreigabe. Nicht ausführbar. Bahnen zeigen Verantwortung, keine nachgewiesene technische Isolation.</bpmn:documentation>
    <bpmn:laneSet id="laneSet_p04KorrekturAenderungsvorschlag">
      <bpmn:lane id="P04_Lane_a" name="Arbeitsagent / Vorschlag">
        <bpmn:flowNodeRef>P04_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_Ursache</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_Bereich</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_Einmalig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_Vorschlag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_Zurueck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_Nein</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P04_Lane_m" name="Person / zuständiger Besitzer">
        <bpmn:flowNodeRef>P04_Persoenlich</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_EndePrivat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_JaNein</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_Ja</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_Release</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P04_Lane_r" name="Prüfung / Repository">
        <bpmn:flowNodeRef>P04_Sichtbarkeit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_Geeignet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_Rueckweg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_Wartet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_PR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_Pruefung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_Bestanden</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_Fehlgeschlagen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_Join_Fehlgeschlagen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_Merge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P04_Lane_g" name="Paketbau / Verteilung">
        <bpmn:flowNodeRef>P04_Build</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_Test</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_TestOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_Stand</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_Ende</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P04_Start" name="Bestätigte Korrektur liegt vor">
      <bpmn:documentation>Auch ein Kontext-Hinweis aus P05 kann Material sein. Ein bloß beobachtetes Verhalten ist noch keine neue Firmenregel.
Quelle: ../../AGENTS.md</bpmn:documentation>
      <bpmn:outgoing>P04_Flow_Start_Ursache</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="P04_Flow_Start_Ursache" sourceRef="P04_Start" targetRef="P04_Ursache" />
    <bpmn:serviceTask id="P04_Ursache" name="Ursache und Geltungsbereich einordnen">
      <bpmn:documentation>Quelle falsch, Kontext fehlt, Skill unklar, Werkzeuggrenze oder einmalige Präferenz? Zuständige vorhandene Quelle suchen, keine zusätzliche Regelkopie schaffen.
Quelle: ../szenarien.md</bpmn:documentation>
      <bpmn:incoming>P04_Flow_Start_Ursache</bpmn:incoming>
      <bpmn:outgoing>P04_Flow_Ursache_Bereich</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="P04_Flow_Ursache_Bereich" sourceRef="P04_Ursache" targetRef="P04_Bereich" />
    <bpmn:exclusiveGateway id="P04_Bereich" name="Welcher Geltungsbereich?">
      <bpmn:documentation>Im Zweifel einmalig. Persönlich, Projekt/Rolle und firmenweit sind unterschiedliche Zielkreise.
Quelle: ../../AGENTS.md</bpmn:documentation>
      <bpmn:incoming>P04_Flow_Ursache_Bereich</bpmn:incoming>
      <bpmn:outgoing>P04_Flow_Bereich_Einmalig</bpmn:outgoing>
      <bpmn:outgoing>P04_Flow_Bereich_Persoenlich</bpmn:outgoing>
      <bpmn:outgoing>P04_Flow_Bereich_Vorschlag</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P04_Flow_Bereich_Einmalig" name="einmalig" sourceRef="P04_Bereich" targetRef="P04_Einmalig" />
    <bpmn:sequenceFlow id="P04_Flow_Bereich_Persoenlich" name="persönlich" sourceRef="P04_Bereich" targetRef="P04_Persoenlich" />
    <bpmn:sequenceFlow id="P04_Flow_Bereich_Vorschlag" name="Projekt / Rolle / Firma" sourceRef="P04_Bereich" targetRef="P04_Vorschlag" />
    <bpmn:endEvent id="P04_Einmalig" name="Einmalig, im privaten Vorgang vermerkt">
      <bpmn:documentation>Kein gemeinsamer Paketwechsel. Der Inhalt bleibt im zulässigen persönlichen Arbeitsbereich.
Quelle: ../../AGENTS.md</bpmn:documentation>
      <bpmn:incoming>P04_Flow_Bereich_Einmalig</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P04_Persoenlich" name="Persönliche Änderung bestätigen">
      <bpmn:documentation>Nur im persönlichen Bereich und nach Zustimmung der Person pflegen. Firmenregeln bleiben davon unberührt.
Quelle: ../../PRD.md</bpmn:documentation>
      <bpmn:incoming>P04_Flow_Bereich_Persoenlich</bpmn:incoming>
      <bpmn:outgoing>P04_Flow_Persoenlich_EndePrivat</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="P04_Flow_Persoenlich_EndePrivat" sourceRef="P04_Persoenlich" targetRef="P04_EndePrivat" />
    <bpmn:endEvent id="P04_EndePrivat" name="Persönlicher Stand angepasst">
      <bpmn:documentation>Keine Weitergabe privater Inhalte an andere Personen.
Quelle: ../../PRD.md</bpmn:documentation>
      <bpmn:incoming>P04_Flow_Persoenlich_EndePrivat</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P04_Vorschlag" name="Änderung + Prüffall + Herkunft entwerfen">
      <bpmn:documentation>Ort, Wortlaut und Prüffall für die zuständige Quelle beschreiben. Projekt-/Rollenänderungen behalten ihren begrenzten Empfängerkreis.
Quelle: ../../AGENTS.md</bpmn:documentation>
      <bpmn:incoming>P04_Flow_Bereich_Vorschlag</bpmn:incoming>
      <bpmn:outgoing>P04_Flow_Vorschlag_Sichtbarkeit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="P04_Flow_Vorschlag_Sichtbarkeit" sourceRef="P04_Vorschlag" targetRef="P04_Sichtbarkeit" />
    <bpmn:scriptTask id="P04_Sichtbarkeit" name="Eignung für den Zielkreis prüfen">
      <bpmn:documentation>Keine privaten Rohchats, Kunden-/Personendaten oder Zugangsdaten in gemeinsame beziehungsweise öffentliche Artefakte übernehmen. Automatische Markerprüfung allein ist kein Vollständigkeitsbeweis.
Quelle: ../../SICHERHEIT.md</bpmn:documentation>
      <bpmn:incoming>P04_Flow_Vorschlag_Sichtbarkeit</bpmn:incoming>
      <bpmn:outgoing>P04_Flow_Sichtbarkeit_Geeignet</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="P04_Flow_Sichtbarkeit_Geeignet" sourceRef="P04_Sichtbarkeit" targetRef="P04_Geeignet" />
    <bpmn:exclusiveGateway id="P04_Geeignet" name="Vorschlag für Zielkreis geeignet?">
      <bpmn:documentation>Eine private Zusammenfassung wird durch Nützlichkeit nicht firmenöffentlich. Bei Zweifel zurück zur Quelle und zum Besitzer.
Quelle: https://ai-first.ai/insights/wie-unser-kontext-layer-mitwaechst</bpmn:documentation>
      <bpmn:incoming>P04_Flow_Sichtbarkeit_Geeignet</bpmn:incoming>
      <bpmn:outgoing>P04_Flow_Geeignet_Zurueck</bpmn:outgoing>
      <bpmn:outgoing>P04_Flow_Geeignet_JaNein</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P04_Flow_Geeignet_Zurueck" name="nein / offen" sourceRef="P04_Geeignet" targetRef="P04_Zurueck" />
    <bpmn:sequenceFlow id="P04_Flow_Geeignet_JaNein" name="ja" sourceRef="P04_Geeignet" targetRef="P04_JaNein" />
    <bpmn:endEvent id="P04_Zurueck" name="Privat belassen oder neu aufbereiten">
      <bpmn:documentation>Keine Erweiterung des Leser- oder Empfängerkreises.
Quelle: ../../SICHERHEIT.md</bpmn:documentation>
      <bpmn:incoming>P04_Flow_Geeignet_Zurueck</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="P04_JaNein" name="Zuständige Person entscheidet über Vorschlag">
      <bpmn:documentation>Die in AGENTS geregelte Zustimmung einholen. Ein Diagramm oder Modellurteil ersetzt dieses Ja nicht.
Quelle: ../../AGENTS.md</bpmn:documentation>
      <bpmn:incoming>P04_Flow_Geeignet_JaNein</bpmn:incoming>
      <bpmn:outgoing>P04_Flow_JaNein_Ja</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="P04_Flow_JaNein_Ja" sourceRef="P04_JaNein" targetRef="P04_Ja" />
    <bpmn:exclusiveGateway id="P04_Ja" name="Zustimmung liegt vor?">
      <bpmn:documentation>Nein oder einmalig beendet die gemeinsame Änderung. Zustimmung und zugrunde liegende Fassung festhalten.
Quelle: ../../AGENTS.md</bpmn:documentation>
      <bpmn:incoming>P04_Flow_JaNein_Ja</bpmn:incoming>
      <bpmn:outgoing>P04_Flow_Ja_Nein</bpmn:outgoing>
      <bpmn:outgoing>P04_Flow_Ja_Rueckweg</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P04_Flow_Ja_Nein" name="nein / einmalig" sourceRef="P04_Ja" targetRef="P04_Nein" />
    <bpmn:sequenceFlow id="P04_Flow_Ja_Rueckweg" name="ja" sourceRef="P04_Ja" targetRef="P04_Rueckweg" />
    <bpmn:endEvent id="P04_Nein" name="Nicht übernommen / einmalig">
      <bpmn:documentation>Entscheidung vermerken; keine gemeinsame Quelle ändern.
Quelle: ../../AGENTS.md</bpmn:documentation>
      <bpmn:incoming>P04_Flow_Ja_Nein</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P04_Rueckweg" name="Zulässiger Beitragsweg vorhanden?">
      <bpmn:documentation>Mitarbeitende mit gefiltertem Paket erhalten nicht automatisch Leserechte am vollständigen Quell-Repo. Der technische Rückweg ist L8.
Quelle: ../../PRD.md</bpmn:documentation>
      <bpmn:incoming>P04_Flow_Ja_Rueckweg</bpmn:incoming>
      <bpmn:outgoing>P04_Flow_Rueckweg_Wartet</bpmn:outgoing>
      <bpmn:outgoing>P04_Flow_Rueckweg_PR</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P04_Flow_Rueckweg_Wartet" name="nein" sourceRef="P04_Rueckweg" targetRef="P04_Wartet" />
    <bpmn:sequenceFlow id="P04_Flow_Rueckweg_PR" name="ja" sourceRef="P04_Rueckweg" targetRef="P04_PR" />
    <bpmn:endEvent id="P04_Wartet" name="Wartet auf Beitragsweg / L8">
      <bpmn:documentation>Keinen Repository-Zugang oder externen Transport erfinden.
Quelle: ../../PRD.md</bpmn:documentation>
      <bpmn:incoming>P04_Flow_Rueckweg_Wartet</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P04_PR" name="Änderung als Pull Request vorlegen">
      <bpmn:documentation>Nur die freigegebene, zulässige Änderung an der zuständigen Quelle. Ein PR bleibt ein Vorschlag.
Quelle: ../../installation/README.md</bpmn:documentation>
      <bpmn:incoming>P04_Flow_Rueckweg_PR</bpmn:incoming>
      <bpmn:outgoing>P04_Flow_PR_Pruefung</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="P04_Flow_PR_Pruefung" sourceRef="P04_PR" targetRef="P04_Pruefung" />
    <bpmn:serviceTask id="P04_Pruefung" name="Regression, Quellen und Schutzregeln prüfen">
      <bpmn:documentation>Bestehende Evals, Quellenverweise, Klassifizierungs- und Geheimnisprüfungen anwenden. Kriterien und Ampel nicht still lockern.
Quelle: ../pruefszenarien.md</bpmn:documentation>
      <bpmn:incoming>P04_Flow_PR_Pruefung</bpmn:incoming>
      <bpmn:outgoing>P04_Flow_Pruefung_Bestanden</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="P04_Flow_Pruefung_Bestanden" sourceRef="P04_Pruefung" targetRef="P04_Bestanden" />
    <bpmn:exclusiveGateway id="P04_Bestanden" name="Prüfungen bestanden?">
      <bpmn:documentation>Fehler erhalten bisherigen freigegebenen Stand. Reparatur als neuer Vorschlagsstand, keine Umgehung des Prüftors.
Quelle: ../../installation/README.md</bpmn:documentation>
      <bpmn:incoming>P04_Flow_Pruefung_Bestanden</bpmn:incoming>
      <bpmn:outgoing>P04_Flow_Bestanden_Fehlgeschlagen</bpmn:outgoing>
      <bpmn:outgoing>P04_Flow_Bestanden_Merge</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P04_Flow_Bestanden_Fehlgeschlagen" name="nein" sourceRef="P04_Bestanden" targetRef="P04_Join_Fehlgeschlagen" />
    <bpmn:sequenceFlow id="P04_Flow_Bestanden_Merge" name="ja" sourceRef="P04_Bestanden" targetRef="P04_Merge" />
    <bpmn:endEvent id="P04_Fehlgeschlagen" name="Änderung abgelehnt, alter Stand gilt">
      <bpmn:documentation>Befund samt fehlgeschlagenem Prüffall zurückgeben.
Quelle: ../pruefszenarien.md</bpmn:documentation>
      <bpmn:incoming>P04_Flow_Join_Fehlgeschlagen_Fehlgeschlagen</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="P04_Merge" name="Geltende Freigabe und Mergeverfahren anwenden">
      <bpmn:documentation>Die zuvor bestätigte Änderung gemäß geltendem Repository-Verfahren und Branchschutz zusammenführen. Zuständige menschliche Freigaben bleiben erhalten; erlaubtes technisches Mergen darf ein Agent übernehmen. Ampel, Sperren und Grundregeln gibt ausschließlich ein Mensch frei. Diese Darstellung verlangt keine zusätzliche pauschale manuelle Mergefreigabe.
Quelle: ../../AGENTS.md</bpmn:documentation>
      <bpmn:incoming>P04_Flow_Bestanden_Merge</bpmn:incoming>
      <bpmn:outgoing>P04_Flow_Merge_Build</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="P04_Flow_Merge_Build" sourceRef="P04_Merge" targetRef="P04_Build" />
    <bpmn:scriptTask id="P04_Build" name="Pakete je zulässigem Kreis bauen">
      <bpmn:documentation>Gleicher Quellstand, erkennbare Version. OpenWebUI und Codex beziehen ihre Grundlage aus denselben zuständigen Quellen; Adapter erfinden keinen zweiten Regelbestand.
Quelle: ../../installation/README.md</bpmn:documentation>
      <bpmn:incoming>P04_Flow_Merge_Build</bpmn:incoming>
      <bpmn:outgoing>P04_Flow_Build_Test</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="P04_Flow_Build_Test" sourceRef="P04_Build" targetRef="P04_Test" />
    <bpmn:callActivity id="P04_Test" name="P07 · Neue Fassung und Rücknahme prüfen" calledElement="Process_P07">
      <bpmn:documentation>In Testumgebung einschließlich frischer Sitzung B ohne privaten Marker von A prüfen. Ein Paketvergleich ist noch kein echter Sitzungsnachweis.
Quelle: ../pruefszenarien.md</bpmn:documentation>
      <bpmn:incoming>P04_Flow_Build_Test</bpmn:incoming>
      <bpmn:outgoing>P04_Flow_Test_TestOk</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="P04_Flow_Test_TestOk" sourceRef="P04_Test" targetRef="P04_TestOk" />
    <bpmn:exclusiveGateway id="P04_TestOk" name="Bereitstellung abgenommen?">
      <bpmn:documentation>Ohne erfolgreiche Abnahme kein Wechsel des aktiven gemeinsamen Stands.
Quelle: ../../installation/README.md</bpmn:documentation>
      <bpmn:incoming>P04_Flow_Test_TestOk</bpmn:incoming>
      <bpmn:outgoing>P04_Flow_TestOk_Fehlgeschlagen</bpmn:outgoing>
      <bpmn:outgoing>P04_Flow_TestOk_Release</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P04_Flow_TestOk_Fehlgeschlagen" name="nein" sourceRef="P04_TestOk" targetRef="P04_Join_Fehlgeschlagen" />
    <bpmn:sequenceFlow id="P04_Flow_TestOk_Release" name="ja" sourceRef="P04_TestOk" targetRef="P04_Release" />
    <bpmn:userTask id="P04_Release" name="Bereitstellung ausdrücklich freigeben">
      <bpmn:documentation>Die geltende Release-Freigabe anwenden. Der Modellierungsauftrag schaltet keine Verteilung ein.
Quelle: ../../installation/README.md</bpmn:documentation>
      <bpmn:incoming>P04_Flow_TestOk_Release</bpmn:incoming>
      <bpmn:outgoing>P04_Flow_Release_Stand</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="P04_Flow_Release_Stand" sourceRef="P04_Release" targetRef="P04_Stand" />
    <bpmn:serviceTask id="P04_Stand" name="Version bereitstellen und Sitzungen zuordnen">
      <bpmn:documentation>Frische Sitzungen erhalten passende neue Fassung. Bestehende Sitzungen behalten erkennbaren Stand oder wechseln kontrolliert; kein sofortiges Update behaupten.
Quelle: ../../installation/README.md</bpmn:documentation>
      <bpmn:incoming>P04_Flow_Release_Stand</bpmn:incoming>
      <bpmn:outgoing>P04_Flow_Stand_Ende</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="P04_Flow_Stand_Ende" sourceRef="P04_Stand" targetRef="P04_Ende" />
    <bpmn:endEvent id="P04_Ende" name="Geprüfte Verbesserung bereit">
      <bpmn:documentation>Version, Zielkreis, Prüfnachweis und möglicher Rücknahmestand sind nachvollziehbar.
Quelle: ../../installation/README.md</bpmn:documentation>
      <bpmn:incoming>P04_Flow_Stand_Ende</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P04_Join_Fehlgeschlagen">
      <bpmn:documentation>Alternative Eingänge ausdrücklich zusammenführen; keine Synchronisation paralleler Ausführungen.
Quelle: ../szenarien.md</bpmn:documentation>
      <bpmn:incoming>P04_Flow_Bestanden_Fehlgeschlagen</bpmn:incoming>
      <bpmn:incoming>P04_Flow_TestOk_Fehlgeschlagen</bpmn:incoming>
      <bpmn:outgoing>P04_Flow_Join_Fehlgeschlagen_Fehlgeschlagen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P04_Flow_Join_Fehlgeschlagen_Fehlgeschlagen" sourceRef="P04_Join_Fehlgeschlagen" targetRef="P04_Fehlgeschlagen" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_collaboration_p04KorrekturAenderungsvorschlag">
    <bpmndi:BPMNPlane id="BPMNPlane_collaboration_p04KorrekturAenderungsvorschlag" bpmnElement="collaboration_p04KorrekturAenderungsvorschlag">
      <bpmndi:BPMNShape id="BPMNShape_P04_Pool" bpmnElement="P04_Pool" isHorizontal="true">
        <dc:Bounds x="80" y="80" width="3027" height="1028" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_P04_Lane_a" bpmnElement="P04_Lane_a" isHorizontal="true">
        <dc:Bounds x="110" y="80" width="2997" height="332" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_P04_Lane_m" bpmnElement="P04_Lane_m" isHorizontal="true">
        <dc:Bounds x="110" y="412" width="2997" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_P04_Lane_r" bpmnElement="P04_Lane_r" isHorizontal="true">
        <dc:Bounds x="110" y="692" width="2997" height="250" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_P04_Lane_g" bpmnElement="P04_Lane_g" isHorizontal="true">
        <dc:Bounds x="110" y="942" width="2997" height="166" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_P04_Start" bpmnElement="P04_Start">
        <dc:Bounds x="170" y="132" width="36" height="36" />
