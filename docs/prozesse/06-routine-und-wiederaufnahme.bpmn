          <dc:Bounds x="403" y="96" width="96" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_P06_Inaktiv" bpmnElement="P06_Inaktiv">
        <dc:Bounds x="568" y="310" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="549" y="352" width="75" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_P06_Schluessel" bpmnElement="P06_Schluessel" bioc:stroke="#205022" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#205022">
        <dc:Bounds x="536" y="129" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_P06_Doppelt" bpmnElement="P06_Doppelt" isMarkerVisible="true">
        <dc:Bounds x="696" y="144" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="684" y="82" width="75" height="56" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_P06_Alt" bpmnElement="P06_Alt">
        <dc:Bounds x="838" y="310" width="36" height="36" />
