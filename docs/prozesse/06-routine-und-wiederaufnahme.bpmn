<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="definitions_p06RoutineUnterbrechungUndWiederaufnahme" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="collaboration_p06RoutineUnterbrechungUndWiederaufnahme">
    <bpmn:participant id="P06_Pool" name="P06 · Routine, Unterbrechung und Wiederaufnahme" processRef="Process_P06" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P06" name="P06 · Routine, Unterbrechung und Wiederaufnahme" isExecutable="false">
    <bpmn:documentation>Entwurf v0.2 | GPT-6-astra | 11.11.2026
Zweck: Einen ausdrücklich freigegebenen Hintergrundauftrag nachvollziehbar starten, anhalten und ohne unbemerkte Doppelwirkung fortsetzen.
Offen: L1/L15/L25: Engine, Identität, Nachrichtenzustellung und technische Wiederaufnahme sind offen. Ein Diagramm garantiert weder dauerhafte Ausführung noch Exactly-once-Wirkung.
Quellen: ../pruefszenarien.md ; ../../PRD.md ; ../../AGENTS.md
Lesart: Fachlicher Sollprozess zur Diskussion, keine Betriebsfreigabe. Nicht ausführbar. Bahnen zeigen Verantwortung, keine nachgewiesene technische Isolation.
Kapitel: Betrieb prüfen
Kurz: Routine &amp; Neustart</bpmn:documentation>
    <bpmn:laneSet id="laneSet_p06RoutineUnterbrechungUndWiederaufnahme">
      <bpmn:lane id="P06_Lane_g" name="Laufsteuerung / dauerhafter Auftragsstatus">
        <bpmn:flowNodeRef>P06_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_Auftrag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_Aktiv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_Inaktiv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_Schluessel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_Doppelt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_Alt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_Checkpoint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_Blockiert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_EndeBlock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_Melden</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_Antwort</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_Stop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_Beenden</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_Gueltig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_Neu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_Vereinen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_Wirkung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_Fertig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_Ende</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_Join_Beenden</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P06_Lane_a" name="Beauftragter Agent">
        <bpmn:flowNodeRef>P06_Arbeiten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_Fehler</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_Rueckfrage</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P06_Lane_m" name="Zuständige Person">
        <bpmn:flowNodeRef>P06_Ja</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P06_Start" name="Auslöser oder Fortsetzung eingegangen">
      <bpmn:documentation>Manueller Auftrag, freigegebenes Ereignis oder Zeitplan. Ein Auslöser allein erteilt keine zusätzlichen Rechte.
Quelle: ../../PRD.md</bpmn:documentation>
      <bpmn:outgoing>P06_Flow_Start_Auftrag</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="P06_Flow_Start_Auftrag" sourceRef="P06_Start" targetRef="P06_Auftrag" />
    <bpmn:scriptTask id="P06_Auftrag" name="Freigabe, Identität und Grenzen prüfen">
      <bpmn:documentation>Freigabe, Auftragssnapshot, explizites Nutzer- oder Dienstkonto, Quellen, Ziel, Laufgrenzen und zuständige Person prüfen. Ein Zeitplan hat keinen angemeldeten Chatnutzer. Rechte vor Wiederaufnahme erneut prüfen, nicht aus einem alten Profil übernehmen.
Quelle: ../../PRD.md</bpmn:documentation>
      <bpmn:incoming>P06_Flow_Start_Auftrag</bpmn:incoming>
      <bpmn:outgoing>P06_Flow_Auftrag_Aktiv</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="P06_Flow_Auftrag_Aktiv" sourceRef="P06_Auftrag" targetRef="P06_Aktiv" />
    <bpmn:exclusiveGateway id="P06_Aktiv" name="Auftrag gültig und freigegeben?">
      <bpmn:documentation>Abgelaufene oder deaktivierte Aufträge werden nicht durch eine alte Nachricht wieder aktiviert.
Quelle: ../pruefszenarien.md</bpmn:documentation>
      <bpmn:incoming>P06_Flow_Auftrag_Aktiv</bpmn:incoming>
      <bpmn:outgoing>P06_Flow_Aktiv_Inaktiv</bpmn:outgoing>
      <bpmn:outgoing>P06_Flow_Aktiv_Schluessel</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P06_Flow_Aktiv_Inaktiv" name="nein" sourceRef="P06_Aktiv" targetRef="P06_Inaktiv" />
    <bpmn:sequenceFlow id="P06_Flow_Aktiv_Schluessel" name="ja" sourceRef="P06_Aktiv" targetRef="P06_Schluessel" />
    <bpmn:endEvent id="P06_Inaktiv" name="Nicht gestartet">
      <bpmn:documentation>Status und fehlende Voraussetzung sichtbar machen; keine neue Routine einschalten.
Quelle: ../../AGENTS.md</bpmn:documentation>
      <bpmn:incoming>P06_Flow_Aktiv_Inaktiv</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="P06_Schluessel" name="Kennung und bisherigen Zustand ermitteln">
      <bpmn:documentation>Ereigniskennung und Auftragssnapshot verwenden; bestehende Läufe und mögliche bereits erfolgte Wirkungen abgleichen.
Quelle: ../pruefszenarien.md</bpmn:documentation>
      <bpmn:incoming>P06_Flow_Aktiv_Schluessel</bpmn:incoming>
      <bpmn:outgoing>P06_Flow_Schluessel_Doppelt</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="P06_Flow_Schluessel_Doppelt" sourceRef="P06_Schluessel" targetRef="P06_Doppelt" />
    <bpmn:exclusiveGateway id="P06_Doppelt" name="Schon erledigt oder noch laufend?">
      <bpmn:documentation>Eine doppelte Nachricht ist kein neuer unabhängiger Auftrag.
Quelle: ../pruefszenarien.md</bpmn:documentation>
      <bpmn:incoming>P06_Flow_Schluessel_Doppelt</bpmn:incoming>
      <bpmn:outgoing>P06_Flow_Doppelt_Alt</bpmn:outgoing>
      <bpmn:outgoing>P06_Flow_Doppelt_Checkpoint</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P06_Flow_Doppelt_Alt" name="ja" sourceRef="P06_Doppelt" targetRef="P06_Alt" />
    <bpmn:sequenceFlow id="P06_Flow_Doppelt_Checkpoint" name="nein" sourceRef="P06_Doppelt" targetRef="P06_Checkpoint" />
    <bpmn:endEvent id="P06_Alt" name="Bisherigen Status zurückgeben">
      <bpmn:documentation>Ergebnis oder laufenden Auftrag referenzieren, keinen zweiten Lauf anlegen.
Quelle: ../pruefszenarien.md</bpmn:documentation>
      <bpmn:incoming>P06_Flow_Doppelt_Alt</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="P06_Checkpoint" name="Prüfpunkt und nächste Aktion sichern">
      <bpmn:documentation>Status vor riskanten Schritten sichern. Bei unklarer früherer Wirkung zuerst mit dem Zielsystem abgleichen.
Quelle: ../pruefszenarien.md</bpmn:documentation>
      <bpmn:incoming>P06_Flow_Doppelt_Checkpoint</bpmn:incoming>
      <bpmn:outgoing>P06_Flow_Checkpoint_Arbeiten</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="P06_Flow_Checkpoint_Arbeiten" sourceRef="P06_Checkpoint" targetRef="P06_Arbeiten" />
    <bpmn:serviceTask id="P06_Arbeiten" name="Freigegebenen Teilauftrag ausführen">
      <bpmn:documentation>Fachlicher Ablauf nach P01–P03 oder Pflege nach P05. Das geschlossene Browserfenster darf die Zustellung nicht ersetzen.
Quelle: ../../PRD.md</bpmn:documentation>
      <bpmn:incoming>P06_Flow_Checkpoint_Arbeiten</bpmn:incoming>
      <bpmn:outgoing>P06_Flow_Arbeiten_Rueckfrage</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="P06_Flow_Arbeiten_Rueckfrage" sourceRef="P06_Arbeiten" targetRef="P06_Rueckfrage" />
    <bpmn:boundaryEvent id="P06_Fehler" name="Provider / Prozess unterbrochen" attachedToRef="P06_Arbeiten">
      <bpmn:documentation>Providerfehler oder Prozessabbruch. Zustand und mögliche Wirkung prüfen. Quelle: ../pruefszenarien.md#s12-routine-mit-rueckfrage</bpmn:documentation>
      <bpmn:outgoing>P06_Flow_Fehler_Blockiert</bpmn:outgoing>
      <bpmn:errorEventDefinition errorRef="error_routineUnterbrochen" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="P06_Flow_Fehler_Blockiert" sourceRef="P06_Fehler" targetRef="P06_Blockiert" />
    <bpmn:scriptTask id="P06_Blockiert" name="Blocker und sicheren Prüfpunkt melden">
      <bpmn:documentation>Fehlerart und Wiederaufnahmebedingung festhalten. Das Ergebnis gilt nicht als fachlich fehlgeschlagen oder bestanden, solange kein auswertbares Ergebnis vorliegt.
Quelle: ../pruefszenarien.md</bpmn:documentation>
      <bpmn:incoming>P06_Flow_Fehler_Blockiert</bpmn:incoming>
      <bpmn:outgoing>P06_Flow_Blockiert_EndeBlock</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="P06_Flow_Blockiert_EndeBlock" sourceRef="P06_Blockiert" targetRef="P06_EndeBlock" />
    <bpmn:endEvent id="P06_EndeBlock" name="BLOCKIERT, Fortsetzung ausstehend">
      <bpmn:documentation>Ein späterer ausdrücklich zulässiger Fortsetzungsversuch startet über den Eingang und prüft den Zustand erneut.
Quelle: ../pruefszenarien.md</bpmn:documentation>
      <bpmn:incoming>P06_Flow_Blockiert_EndeBlock</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P06_Rueckfrage" name="Entscheidung nötig?">
      <bpmn:documentation>Eine unklare Pflichtangabe, Freigabe oder geänderte Quelle kann eine menschliche Entscheidung brauchen.
Quelle: ../../AGENTS.md</bpmn:documentation>
      <bpmn:incoming>P06_Flow_Arbeiten_Rueckfrage</bpmn:incoming>
      <bpmn:outgoing>P06_Flow_Rueckfrage_Melden</bpmn:outgoing>
      <bpmn:outgoing>P06_Flow_Rueckfrage_Vereinen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P06_Flow_Rueckfrage_Melden" name="ja" sourceRef="P06_Rueckfrage" targetRef="P06_Melden" />
    <bpmn:sequenceFlow id="P06_Flow_Rueckfrage_Vereinen" name="nein" sourceRef="P06_Rueckfrage" targetRef="P06_Vereinen" />
    <bpmn:serviceTask id="P06_Melden" name="Konkrete Fassung zur Entscheidung zustellen">
      <bpmn:documentation>Zuständiger Person, Ergebnisfassung und Quellenstand zuordnen. Kanal und Zustellung bleiben Implementierungsfragen, keine neue Slack-Pflicht.
Quelle: ../../PRD.md</bpmn:documentation>
      <bpmn:incoming>P06_Flow_Rueckfrage_Melden</bpmn:incoming>
      <bpmn:outgoing>P06_Flow_Melden_Antwort</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="P06_Flow_Melden_Antwort" sourceRef="P06_Melden" targetRef="P06_Antwort" />
    <bpmn:receiveTask id="P06_Antwort" name="Auf gebundene Entscheidung warten">
      <bpmn:documentation>Wartestatus dauerhaft speichern. Eine verlorene oder alte Antwort ist keine Freigabe.
Quelle: ../pruefszenarien.md</bpmn:documentation>
      <bpmn:incoming>P06_Flow_Melden_Antwort</bpmn:incoming>
      <bpmn:outgoing>P06_Flow_Antwort_Gueltig</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sequenceFlow id="P06_Flow_Antwort_Gueltig" sourceRef="P06_Antwort" targetRef="P06_Gueltig" />
    <bpmn:boundaryEvent id="P06_Stop" name="Stop / Widerruf" attachedToRef="P06_Antwort">
      <bpmn:documentation>Stop beendet den wartenden Lauf, ohne ihn automatisch zu wiederholen. Quelle: ../pruefszenarien.md</bpmn:documentation>
      <bpmn:outgoing>P06_Flow_Stop_Beenden</bpmn:outgoing>
      <bpmn:signalEventDefinition signalRef="signal_auftragStoppen" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="P06_Flow_Stop_Beenden" sourceRef="P06_Stop" targetRef="P06_Join_Beenden" />
    <bpmn:endEvent id="P06_Beenden" name="ABGEBROCHEN, Stand erhalten">
      <bpmn:documentation>Verbleibende Prozesse und bereits erfolgte Wirkungen prüfen; bei Unsicherheit als offen melden.
Quelle: ../pruefszenarien.md</bpmn:documentation>
      <bpmn:incoming>P06_Flow_Join_Beenden_Beenden</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P06_Gueltig" name="Person, Fassung und Rechte noch gültig?">
      <bpmn:documentation>Antwort mit Auftragskennung, Ergebnisfassung und aktuellem Quellen-/Rechtestand abgleichen. Eine alte Zustimmung darf keine neue Fassung freigeben.
Quelle: ../pruefszenarien.md</bpmn:documentation>
      <bpmn:incoming>P06_Flow_Antwort_Gueltig</bpmn:incoming>
      <bpmn:outgoing>P06_Flow_Gueltig_Neu</bpmn:outgoing>
      <bpmn:outgoing>P06_Flow_Gueltig_Ja</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P06_Flow_Gueltig_Neu" name="nein" sourceRef="P06_Gueltig" targetRef="P06_Neu" />
    <bpmn:sequenceFlow id="P06_Flow_Gueltig_Ja" name="ja" sourceRef="P06_Gueltig" targetRef="P06_Ja" />
    <bpmn:endEvent id="P06_Neu" name="Neue Entscheidung erforderlich">
      <bpmn:documentation>Veraltete Antwort zurückweisen; die zuständige Person bekommt die aktuelle Fassung in einem zulässigen Folgeauftrag.
Quelle: ../pruefszenarien.md</bpmn:documentation>
      <bpmn:incoming>P06_Flow_Gueltig_Neu</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P06_Ja" name="Zugestimmt?">
      <bpmn:documentation>Ablehnung beendet diesen Lauf. Eine Zustimmung bleibt auf den konkret freigegebenen Schritt begrenzt.
Quelle: ../../AGENTS.md</bpmn:documentation>
      <bpmn:incoming>P06_Flow_Gueltig_Ja</bpmn:incoming>
      <bpmn:outgoing>P06_Flow_Ja_Beenden</bpmn:outgoing>
      <bpmn:outgoing>P06_Flow_Ja_Vereinen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P06_Flow_Ja_Beenden" name="nein" sourceRef="P06_Ja" targetRef="P06_Join_Beenden" />
    <bpmn:sequenceFlow id="P06_Flow_Ja_Vereinen" name="ja" sourceRef="P06_Ja" targetRef="P06_Vereinen" />
    <bpmn:exclusiveGateway id="P06_Vereinen">
      <bpmn:documentation>Weiter nur mit ausreichender bestehender Freigabe oder gültiger neuer Entscheidung.
Quelle: ../pruefszenarien.md</bpmn:documentation>
      <bpmn:incoming>P06_Flow_Rueckfrage_Vereinen</bpmn:incoming>
      <bpmn:incoming>P06_Flow_Ja_Vereinen</bpmn:incoming>
      <bpmn:outgoing>P06_Flow_Vereinen_Wirkung</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P06_Flow_Vereinen_Wirkung" sourceRef="P06_Vereinen" targetRef="P06_Wirkung" />
    <bpmn:scriptTask id="P06_Wirkung" name="Erlaubte Wirkung mit Zustand abgleichen">
      <bpmn:documentation>Vor Schreiben im Zielsystem auf bereits vorhandene Wirkung prüfen; bei unklarem früherem Commit abgleichen statt blind wiederholen. Außenhandlungen bleiben beim Menschen nach P03.
Quelle: ../pruefszenarien.md</bpmn:documentation>
      <bpmn:incoming>P06_Flow_Vereinen_Wirkung</bpmn:incoming>
      <bpmn:outgoing>P06_Flow_Wirkung_Fertig</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="P06_Flow_Wirkung_Fertig" sourceRef="P06_Wirkung" targetRef="P06_Fertig" />
    <bpmn:serviceTask id="P06_Fertig" name="Ergebnis und tatsächliche Wirkung melden">
      <bpmn:documentation>Auch ein Lauf ohne Änderungen meldet den Status. Inhaltliche Nacharbeit und Betriebskosten bleiben messbar.
Quelle: ../szenarien.md</bpmn:documentation>
      <bpmn:incoming>P06_Flow_Wirkung_Fertig</bpmn:incoming>
      <bpmn:outgoing>P06_Flow_Fertig_Ende</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="P06_Flow_Fertig_Ende" sourceRef="P06_Fertig" targetRef="P06_Ende" />
    <bpmn:endEvent id="P06_Ende" name="Abgeschlossen und nachvollziehbar">
      <bpmn:documentation>Auftrag, Version, Ergebnis, Wirkungsbeleg und Logstatus sind verbunden; Daten bleiben im zulässigen Kreis.
Quelle: ../pruefszenarien.md</bpmn:documentation>
      <bpmn:incoming>P06_Flow_Fertig_Ende</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P06_Join_Beenden">
      <bpmn:documentation>Alternative Eingänge ausdrücklich zusammenführen; keine Synchronisation paralleler Ausführungen.
Quelle: ../szenarien.md</bpmn:documentation>
      <bpmn:incoming>P06_Flow_Stop_Beenden</bpmn:incoming>
      <bpmn:incoming>P06_Flow_Ja_Beenden</bpmn:incoming>
      <bpmn:outgoing>P06_Flow_Join_Beenden_Beenden</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P06_Flow_Join_Beenden_Beenden" sourceRef="P06_Join_Beenden" targetRef="P06_Beenden" />
  </bpmn:process>
  <bpmn:error id="error_routineUnterbrochen" name="Routine unterbrochen" errorCode="ROUTINE_INTERRUPTED" />
  <bpmn:signal id="signal_auftragStoppen" name="Auftrag stoppen" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_collaboration_p06RoutineUnterbrechungUnd">
    <bpmndi:BPMNPlane id="BPMNPlane_collaboration_p06RoutineUnterbrechungUnd" bpmnElement="collaboration_p06RoutineUnterbrechungUndWiederaufnahme">
      <bpmndi:BPMNShape id="BPMNShape_P06_Pool" bpmnElement="P06_Pool" isHorizontal="true">
        <dc:Bounds x="80" y="80" width="2439" height="641" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_P06_Lane_g" bpmnElement="P06_Lane_g" isHorizontal="true">
        <dc:Bounds x="110" y="80" width="2409" height="318" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_P06_Lane_a" bpmnElement="P06_Lane_a" isHorizontal="true">
        <dc:Bounds x="110" y="398" width="2409" height="203" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_P06_Lane_m" bpmnElement="P06_Lane_m" isHorizontal="true">
        <dc:Bounds x="110" y="601" width="2409" height="120" />
      </bpmndi:BPMNShape>
