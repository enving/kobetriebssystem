        <dc:Bounds x="266" y="129" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_P06_Aktiv" bpmnElement="P06_Aktiv" isMarkerVisible="true">
        <dc:Bounds x="426" y="144" width="50" height="50" />
