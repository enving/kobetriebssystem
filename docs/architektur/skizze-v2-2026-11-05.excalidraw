  {
   "type": "text",
   "id": "k332137785961",
   "x": 40,
   "y": 385,
   "width": 793.6500000000001,
   "height": 32.5,
   "text": "Space = Rechtegrenze (Rakazo VISION.md): Chats, Dateien, Memory, Computer, App-Verbindungen mischen sich nicht.\nFreigaben je Bot: Ask / Auto / Never + Allow/Block-Listen. Webhook-Läufe fragen strenger.",
   "originalText": "Space = Rechtegrenze (Rakazo VISION.md): Chats, Dateien, Memory, Computer, App-Verbindungen mischen sich nicht.\nFreigaben je Bot: Ask / Auto / Never + Allow/Block-Listen. Webhook-Läufe fragen strenger.",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
