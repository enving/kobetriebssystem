{
  "_hinweis": "Entwurf. Projekt: .claude/settings.json. Für alle Geräte: Managed Settings der Organisation / Plugin. Schlüsselnamen vor Einsatz gegen die aktuelle Claude-Code-Doku prüfen.",
  "permissions": {
    "deny": [
      "Read(//Volumes/Laufwerk-Personal/**)",
      "Read(./user-kompass/**/privat/**)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Glob|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "system/hooks/sperre-pfade.sh"
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "system/hooks/block-extern.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "system/hooks/sessionstart-kontext.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "system/hooks/stop-kontextmahnung.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
